# ============================================================================
# REIKI ONLINE (www.reikionline.com.ar) — Variables de Entorno en Vercel
# ============================================================================
# Configurar estas claves en Vercel -> Settings -> Environment Variables
# NUNCA exponer TWILIO_ACCOUNT_SID ni TWILIO_AUTH_TOKEN con prefijo NEXT_PUBLIC_

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tiempo de espera configurable en segundos para reenviar código OTP (por defecto 60s)
NEXT_PUBLIC_VERIFY_COOLDOWN_SECONDS=60
